isCompleteR1 := (D120 = D90) AND X51 AND NOT processComplete;

// Process cancellation retrieval and completion
IF isCancelR0 THEN
    D300 := D100;
    D301 := 2;
ELSIF isCompleteR0 THEN
    D300 := D100;
    D301 := 1;
    processComplete := TRUE;
END_IF

IF isCancelR1 THEN
    D302 := D120;
    D303 := 2;
ELSIF isCompleteR1 THEN
    D302 := D120;
    D303 := 1;
